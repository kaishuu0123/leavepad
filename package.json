{
  "name": "leavepad",
  "version": "2.9.4",
  "description": "Leavepad is a multi-platform notepad. focuses on writing memos.",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "kaishuu0123@gmail.com",
  "homepage": "https://github.com/kaishuu0123/leavepad",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "biome:check": "biome check .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "build:vite": "cross-env NODE_OPTIONS=--max-old-space-size=4096 electron-vite build",
    "start": "electron-vite preview",
    "dev": "electron-vite dev -- --disable-gpu --no-sandbox",
    "build": "pnpm run typecheck && pnpm run build:vite",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win --publish never",
    "build:mac": "pnpm run build:vite && electron-builder --mac --publish never",
    "build:linux": "pnpm run build:vite && electron-builder --linux AppImage snap --publish=never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vscode/codicons": "^0.0.36",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "electron-updater": "^6.8.3",
    "i18next": "^23.16.4",
    "jotai": "^2.10.1",
    "lowdb": "^7.0.1",
    "monaco-editor": "^0.57.0",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^15.1.0",
    "runes": "^0.4.3",
    "uuidv7": "^1.0.2",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.452.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.2",
    "vite": "^7.1.10"
  },
  "packageManager": "pnpm@11.2.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.2.2",
      "onFail": "warn"
    }
  }
}
