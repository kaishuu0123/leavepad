{
  "name": "leavepad",
  "version": "2.10.5",
  "description": "Leavepad is a multi-platform notepad. focuses on writing memos.",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "kaishuu0123@gmail.com",
  "homepage": "https://github.com/kaishuu0123/leavepad",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "biome:check": "biome check .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "build:vite": "cross-env NODE_OPTIONS=--max-old-space-size=4096 electron-vite build",
    "start": "electron-vite preview",
    "dev": "electron-vite dev -- --disable-gpu --no-sandbox",
    "build": "pnpm run typecheck && pnpm run build:vite",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win --publish never",
    "build:mac": "pnpm run build:vite && electron-builder --mac --publish never",
    "build:linux": "pnpm run build:vite && electron-builder --linux AppImage snap --publish=never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@hookform/resolvers": "^5.9.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.5.0",
    "@vscode/codicons": "^0.0.36",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "electron-updater": "^6.8.11",
    "i18next": "^23.16.8",
    "jotai": "^2.20.3",
    "lowdb": "^7.0.1",
    "monaco-editor": "^0.57.0",
    "radix-ui": "^1.8.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^15.7.4",
    "runes": "^0.4.3",
    "uuidv7": "^1.2.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^0.452.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@11.2.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.2.2",
      "onFail": "warn"
    }
  }
}
